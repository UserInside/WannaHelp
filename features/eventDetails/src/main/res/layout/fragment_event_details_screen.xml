<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/spacing_l"
            android:paddingTop="@dimen/spacing_m">

            <TextView
                android:id="@+id/tv_title_event_details"
                style="@style/TextStyle21"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:text="Спонсоры отремонтируют школу-интернат"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tv_event_detail_remains"
                style="@style/TextStyle18"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:drawablePadding="5dp"
                android:gravity="center"
                android:text="Осталось 13 дней (21.09 - 20.10)"
                app:drawableStartCompat="@drawable/icon_calendar"
                app:drawableTint="@color/grey"
                app:layout_constraintStart_toStartOf="@id/tv_title_event_details"
                app:layout_constraintTop_toBottomOf="@id/tv_title_event_details" />

            <TextView
                android:id="@+id/tv_event_details_fond_name"
                style="@style/TextStyle9"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:text="Благотворительный Фонд Счастлиый Мир"
                app:layout_constraintStart_toStartOf="@id/tv_title_event_details"
                app:layout_constraintTop_toBottomOf="@id/tv_event_detail_remains" />

            <ImageView
                android:id="@+id/img_event_details_nav"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:src="@drawable/icon_nav"
                app:layout_constraintStart_toStartOf="@id/tv_title_event_details"
                app:layout_constraintTop_toBottomOf="@id/tv_event_details_fond_name" />

            <TextView
                android:id="@+id/tv_event_details_address"
                style="@style/TextStyle20"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Санкт-Петербург, Кирочная улица, \nд. 50А, каб. 208"
                app:layout_constraintStart_toEndOf="@id/img_event_details_nav"
                app:layout_constraintTop_toTopOf="@id/img_event_details_nav" />

            <ImageView
                android:id="@+id/img_event_details_phone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:src="@drawable/icon_phone"
                app:layout_constraintStart_toStartOf="@id/tv_title_event_details"
                app:layout_constraintTop_toBottomOf="@id/tv_event_details_address" />

            <TextView
                android:id="@+id/tv_event_details_phone"
                style="@style/TextStyle20"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="+7 (937) 037-37-73 \n+7 (937) 016 16-16"
                app:layout_constraintStart_toEndOf="@id/img_event_details_phone"
                app:layout_constraintTop_toTopOf="@id/img_event_details_phone" />

            <ImageView
                android:id="@+id/img_event_details_mail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:src="@drawable/icon_mail"
                app:layout_constraintStart_toStartOf="@id/tv_title_event_details"
                app:layout_constraintTop_toBottomOf="@id/tv_event_details_phone" />

            <TextView
                android:id="@+id/tv_event_details_mail"
                style="@style/TextStyle20"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/have_some_questions"
                app:layout_constraintStart_toEndOf="@id/img_event_details_mail"
                app:layout_constraintTop_toTopOf="@id/img_event_details_mail" />

            <TextView
                style="@style/TextStyle7"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/write_us"
                app:layout_constraintStart_toEndOf="@id/tv_event_details_mail"
                app:layout_constraintTop_toTopOf="@id/tv_event_details_mail" />

            <ImageView
                android:id="@+id/img_primary"
                android:layout_width="205dp"
                android:layout_height="158dp"
                android:layout_marginTop="@dimen/spacing_l"
                android:src="@drawable/cardimage_1"
                app:layout_constraintStart_toStartOf="@id/tv_title_event_details"
                app:layout_constraintTop_toBottomOf="@id/img_event_details_mail" />

            <ImageView
                android:id="@+id/img_secondary1"
                android:layout_width="105dp"
                android:layout_height="74dp"
                android:layout_marginStart="10dp"
                android:src="@drawable/cardimage_2"
                app:layout_constraintStart_toEndOf="@id/img_primary"
                app:layout_constraintTop_toTopOf="@id/img_primary" />

            <ImageView
                android:id="@+id/img_secondary2"
                android:layout_width="105dp"
                android:layout_height="74dp"
                android:layout_marginStart="10dp"
                android:layout_marginTop="10dp"
                android:src="@drawable/cardimage_3"
                app:layout_constraintBottom_toBottomOf="@id/img_primary"
                app:layout_constraintStart_toEndOf="@id/img_primary" />

            <TextView
                android:id="@+id/tv_event_details_description1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_l"
                android:text="Участники и болельщики смогли весело и активно провести время на «Петербургском благотворительном марафоне» и при этом финансово поучаствовать в помощи детям."
                app:layout_constraintStart_toStartOf="@id/tv_title_event_details"
                app:layout_constraintTop_toBottomOf="@id/img_primary" />

            <TextView
                android:id="@+id/tv_event_details_description2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="При этом финансово поучаствовать в помощи детям. При этом финансово поучаствовать в помощи детям."
                app:layout_constraintStart_toStartOf="@id/tv_title_event_details"
                app:layout_constraintTop_toBottomOf="@id/tv_event_details_description1" />

            <TextView
                android:id="@+id/tv_event_details_go_to_fond_site"
                style="@style/TextStyle7"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_l"
                android:layout_marginBottom="5dp"
                android:text="@string/go_to_organisation_site"
                app:layout_constraintStart_toStartOf="@id/tv_title_event_details"
                app:layout_constraintTop_toBottomOf="@id/tv_event_details_description2" />


            <LinearLayout
                android:id="@+id/contributors"
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_marginTop="@dimen/spacing_l"
                android:background="@color/light_grey"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_event_details_go_to_fond_site">

                <ImageView
                    android:id="@+id/avatar1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_l"
                    android:contentDescription="@null"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/friendsLabel"
                    app:srcCompat="@drawable/placeholder_24" />

                <ImageView
                    android:id="@+id/avatar2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@null"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/friendsLabel"
                    app:srcCompat="@drawable/placeholder_24" />

                <ImageView
                    android:id="@+id/avatar3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@null"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/friendsLabel"
                    app:srcCompat="@drawable/placeholder_24" />

                <ImageView
                    android:id="@+id/avatar4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@null"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/friendsLabel"
                    app:srcCompat="@drawable/placeholder_24" />

                <TextView
                    android:id="@+id/viewersCount"
                    style="@style/TextStyle3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_l"
                    android:text="+102" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/buttonsLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:orientation="horizontal"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@id/contributors">

                <LinearLayout
                    android:id="@+id/buttonThings"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:paddingTop="9dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null"
                        android:layout_gravity="center"
                        android:background="@color/white"
                        android:src="@drawable/ic_shirt" />

                    <TextView
                        style="@style/TextStyle11"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="7dp"
                        android:text="@string/help_things" />
                </LinearLayout>

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="70dp"
                    android:contentDescription="@null"
                    android:src="@drawable/separator_1" />

                <LinearLayout
                    android:id="@+id/buttonVolunteer"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:paddingTop="9dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null"
                        android:layout_gravity="center"
                        android:background="@color/white"
                        android:src="@drawable/ic_hands" />

                    <TextView
                        style="@style/TextStyle11"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="7dp"
                        android:text="@string/become_volunteer" />
                </LinearLayout>

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="70dp"
                    android:contentDescription="@null"
                    android:src="@drawable/separator_1" />

                <LinearLayout
                    android:id="@+id/buttonTools"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:paddingTop="9dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:background="@color/white"
                        android:src="@drawable/ic_tools" />

                    <TextView
                        style="@style/TextStyle11"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="7dp"
                        android:text="@string/help_professional" />
                </LinearLayout>

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="70dp"
                    android:contentDescription="@null"
                    android:src="@drawable/separator_1" />

                <LinearLayout
                    android:id="@+id/buttonCoins"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:paddingTop="9dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:background="@color/white"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_coins" />

                    <TextView
                        style="@style/TextStyle11"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="7dp"
                        android:text="@string/help_money" />
                </LinearLayout>

            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

</FrameLayout>


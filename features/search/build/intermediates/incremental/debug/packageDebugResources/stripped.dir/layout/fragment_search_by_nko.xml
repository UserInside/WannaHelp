<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_grey_two">

    <TextView
        android:id="@+id/tv_search_by_nko_result_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/TextStyle3"
        android:layout_marginTop="@dimen/spacing_l"
        android:layout_marginHorizontal="@dimen/spacing_l"
        android:background="@color/transparent"
        android:text="Ключевые слова: мастер-класс, помощь\nРезультаты поиска: 109 меропиятий"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view_search_results"
        android:layout_marginTop="@dimen/spacing_l"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        app:layout_constraintTop_toBottomOf="@id/tv_search_by_nko_result_title" />

</androidx.constraintlayout.widget.ConstraintLayout>
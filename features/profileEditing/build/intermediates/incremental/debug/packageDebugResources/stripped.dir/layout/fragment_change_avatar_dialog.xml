<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_layout_background"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/spacing_xl"
    android:paddingTop="@dimen/spacing_xxl_2"
    android:paddingBottom="@dimen/spacing_xxl">

    <TextView
        android:id="@+id/tv_choose_photo"
        style="@style/TextStyle14"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawablePadding="@dimen/spacing_xl"
        android:text="@string/tv_choose_photo"
        app:drawableStartCompat="@drawable/upload"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_make_photo"
        style="@style/TextStyle14"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="44dp"
        android:drawablePadding="@dimen/spacing_xl"
        android:text="@string/tv_make_photo"
        app:drawableStartCompat="@drawable/camera"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_choose_photo" />

    <TextView
        android:id="@+id/tv_delete"
        style="@style/TextStyle14"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="44dp"
        android:drawablePadding="@dimen/spacing_xl"
        android:text="@string/tv_delete"
        app:drawableStartCompat="@drawable/delete"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_make_photo" />

</androidx.constraintlayout.widget.ConstraintLayout>
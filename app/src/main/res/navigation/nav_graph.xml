<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/wannaHelpScreenFragment">

    <fragment
        android:id="@+id/profileScreenFragment"
        android:name="com.example.wannahelp.profileScreen.ProfileScreenFragment"
        android:label="fragment_profile_screen"
        tools:layout="@layout/fragment_profile_screen" >
        <action
            android:id="@+id/navigateToEditProfileScreen"
            app:destination="@id/profileEditScreenFragment" />
    </fragment>
    <fragment
        android:id="@+id/profileEditScreenFragment"
        android:name="com.example.wannahelp.profileEditScreen.EditProfileScreenFragment"
        android:label="ProfileEditScreenFragment" >
        <action
            android:id="@+id/navigateToProfileScreen"
            app:destination="@id/profileScreenFragment" />
    </fragment>
    <fragment
        android:id="@+id/wannaHelpScreenFragment"
        android:name="com.example.wannahelp.wannaHelpScreen.WannaHelpScreenFragment"
        android:label="WannaHelpScreenFragment" />
    <fragment
        android:id="@+id/searchScreenFragment"
        android:name="com.example.wannahelp.searchScreen.SearchScreenFragment"
        android:label="fragment_search_screen"
        tools:layout="@layout/fragment_search_screen" />
    <fragment
        android:id="@+id/newsScreenFragment"
        android:name="com.example.wannahelp.newsScreen.NewsScreenFragment"
        android:label="fragment_news_screen"
        tools:layout="@layout/fragment_news_screen" />
</navigation>